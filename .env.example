# ==============================================================================
# Lufria Monitor - Environment Configuration Example
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Server & Origin Configuration
# Public origin where the dashboard is accessed (required for Passkey / WebAuthn validation)
MONITOR_ORIGIN=https://monitor.lufria.tech
HOST=0.0.0.0
PORT=8090

# Optional AI Router Provider API Keys
# These can also be configured dynamically in the Settings UI (Settings -> AI Providers)
HERMES_CUSTOM_9ROUTER_LUFRIA_TECH_API_KEY=
HERMES_CUSTOM_OMOAPICALL_WEB_ID_API_KEY=
HERMES_CUSTOM_ROUTER_BINAV_ID_API_KEY=
